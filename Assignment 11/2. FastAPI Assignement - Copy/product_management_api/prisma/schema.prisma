generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "sqlite"
  url      = "file:./products.db"
}

model Company {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  price       Float
  company     Company   @relation(fields: [company_id], references: [id])
  company_id  Int
  category    Category  @relation(fields: [category_id], references: [id])
  category_id Int
}
